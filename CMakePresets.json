{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "include": ["lib/skyrim-mod-toolchain/cmake/CMakePresets.json"],
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "core",
      "displayName": "Core libraries and unit tests (native Linux)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TOM_BUILD_TESTS": "ON",
        "TOM_BUILD_PLUGIN": "OFF"
      }
    },
    {
      "name": "core-asan",
      "displayName": "Core unit tests under AddressSanitizer and UndefinedBehaviorSanitizer (native Linux)",
      "inherits": "core",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all"
      }
    },
    {
      "name": "plugin",
      "displayName": "SKSE plugin DLLs (Linux host, clang-cl cross-compile)",
      "inherits": "skse-clangcl",
      "cacheVariables": {
        "TOM_BUILD_TESTS": "OFF",
        "TOM_BUILD_PLUGIN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "core",
      "configurePreset": "core"
    },
    {
      "name": "core-asan",
      "configurePreset": "core-asan"
    },
    {
      "name": "plugin",
      "configurePreset": "plugin"
    }
  ],
  "testPresets": [
    {
      "name": "core",
      "configurePreset": "core",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "core-asan",
      "inherits": "core",
      "configurePreset": "core-asan",
      "environment": {
        "ASAN_OPTIONS": "halt_on_error=1:detect_leaks=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "core-asan",
      "displayName": "Core unit tests under ASan and UBSan: configure, build and test",
      "steps": [
        {
          "type": "configure",
          "name": "core-asan"
        },
        {
          "type": "build",
          "name": "core-asan"
        },
        {
          "type": "test",
          "name": "core-asan"
        }
      ]
    }
  ]
}
