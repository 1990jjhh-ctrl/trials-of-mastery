{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "include": ["lib/skyrim-mod-toolchain/cmake/CMakePresets.json"],
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "core",
      "displayName": "Core libraries and unit tests (native Linux)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "TOM_BUILD_TESTS": "ON",
        "TOM_BUILD_PLUGIN": "OFF"
      }
    },
    {
      "name": "plugin",
      "displayName": "SKSE plugin DLLs (Linux host, clang-cl cross-compile)",
      "inherits": "skse-clangcl",
      "cacheVariables": {
        "TOM_BUILD_TESTS": "OFF",
        "TOM_BUILD_PLUGIN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "core",
      "configurePreset": "core"
    },
    {
      "name": "plugin",
      "configurePreset": "plugin"
    }
  ],
  "testPresets": [
    {
      "name": "core",
      "configurePreset": "core",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
